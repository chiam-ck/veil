# Copy to .env, chmod 600 .env, then configure your approved provider.
# This file contains examples only. Never commit .env or real credentials.
# Base deployment publishes HTTPS on loopback only.
COMPOSE_FILE=compose.yaml
VEIL_UID=1000
VEIL_GID=1000
VEIL_ALLOWED_HOSTS=127.0.0.1,localhost,veil-api
# For private-network access, use compose.yaml:compose.pilot.yaml and set:
# VEIL_PILOT_ADDRESS=YOUR_PRIVATE_IP
# VEIL_ALLOWED_HOSTS=YOUR_PRIVATE_IP,YOUR_APPROVED_HOSTNAME,127.0.0.1,localhost,veil-api
# Generate a matching certificate before startup; see README.md.

# LLM-only detection. Explicit opt-in is required before sending document text.
VEIL_DETECTOR=llm
VEIL_LLM_ENDPOINT=https://api.example.com/v1
VEIL_LLM_MODEL=your-model-id
VEIL_LLM_API_KEY=
VEIL_LLM_ALLOW_NETWORK=false
# Optional file-based secret: add compose.secrets.yaml to COMPOSE_FILE and create
# the private file below (never committed). It replaces the environment key.
# VEIL_LLM_SECRET_FILE=./secrets/llm_api_key

# Conservative defaults for providers supporting one inference at a time.
VEIL_WORKERS=1
VEIL_LLM_CONCURRENCY=1
VEIL_LLM_TIMEOUT=60
VEIL_LLM_MAX_CALLS=300
VEIL_LLM_INPUT_TOKEN_BUDGET=4096
VEIL_LLM_MAX_OUTPUT_TOKENS=8192
# Input uses a conservative UTF-8 byte estimate. Reserve room in the model context
# for the configured output ceiling. Both budgets are provider-independent.
VEIL_PROVIDER_CHECK_TTL=300
VEIL_PROVIDER_RETRY_SECONDS=5
VEIL_PROVIDER_WAIT_TIMEOUT=900

# Bounded uploads, jobs, batch exports and terminal-job storage retention.
VEIL_MAX_BYTES=31457280
VEIL_MAX_PAGES=60
VEIL_MAX_QUEUE=32
VEIL_MAX_BUNDLE_BYTES=2147483648
VEIL_TIMEOUT=600
VEIL_RETENTION_HOURS=24

# Bound anonymous workspace creation; a valid existing cookie reuses its workspace.
VEIL_WORKSPACE_CREATIONS_PER_HOUR=60
VEIL_MAX_WORKSPACES=10000
